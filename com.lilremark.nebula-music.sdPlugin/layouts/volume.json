{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/layout.json",
  "id": "com.lilremark.nebula-music.volume",
  "items": [
    { "key": "icon", "type": "pixmap", "rect": [8, 18, 42, 44] },
    {
      "key": "label",
      "type": "text",
      "rect": [59, 12, 135, 18],
      "alignment": "left",
      "color": "#a3a3a3",
      "font": { "size": 10, "weight": 700 },
      "value": "VOLUME"
    },
    {
      "key": "value",
      "type": "text",
      "rect": [59, 34, 135, 34],
      "alignment": "left",
      "color": "#fafafa",
      "font": { "size": 26, "weight": 700 }
    },
    {
      "key": "volume",
      "type": "gbar",
      "rect": [8, 84, 184, 7],
      "range": { "min": 0, "max": 100 },
      "bar_bg_c": "#262626",
      "bar_fill_c": "#3b82c4",
      "bar_border_c": "#262626",
      "bar_h": 4,
      "border_w": 0,
      "value": 0
    }
  ]
}
