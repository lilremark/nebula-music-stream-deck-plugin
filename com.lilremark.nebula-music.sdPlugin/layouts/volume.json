{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/layout.json",
  "id": "com.lilremark.nebula-music.volume",
  "items": [
    {
      "key": "label",
      "type": "text",
      "rect": [8, 7, 92, 14],
      "alignment": "left",
      "color": "#737373",
      "font": { "size": 9, "weight": 700 },
      "value": "VOLUME"
    },
    {
      "key": "state",
      "type": "text",
      "rect": [104, 7, 88, 14],
      "alignment": "right",
      "color": "#3b82c4",
      "font": { "size": 9, "weight": 700 }
    },
    {
      "key": "value",
      "type": "text",
      "rect": [8, 30, 184, 37],
      "alignment": "left",
      "color": "#fafafa",
      "font": { "size": 30, "weight": 700 }
    },
    {
      "key": "hint",
      "type": "text",
      "rect": [8, 70, 184, 12],
      "alignment": "center",
      "color": "#737373",
      "font": { "size": 8, "weight": 700 }
    },
    {
      "key": "volume",
      "type": "gbar",
      "rect": [8, 87, 184, 5],
      "range": { "min": 0, "max": 100 },
      "bar_bg_c": "#262626",
      "bar_fill_c": "#3b82c4",
      "bar_border_c": "#262626",
      "bar_h": 4,
      "border_w": 0,
      "value": 0
    }
  ]
}
