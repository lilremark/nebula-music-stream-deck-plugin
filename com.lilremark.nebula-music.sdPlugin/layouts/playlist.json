{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/layout.json",
  "id": "com.lilremark.nebula-music.playlist-browser",
  "items": [
    {
      "key": "label",
      "type": "text",
      "rect": [8, 7, 92, 14],
      "alignment": "left",
      "color": "#737373",
      "font": { "size": 9, "weight": 700 },
      "value": "PLAYLIST"
    },
    {
      "key": "position",
      "type": "text",
      "rect": [104, 7, 88, 14],
      "alignment": "right",
      "color": "#3b82c4",
      "font": { "size": 9, "weight": 700 }
    },
    {
      "key": "playlistLabel",
      "type": "text",
      "rect": [8, 31, 184, 12],
      "alignment": "left",
      "color": "#a3a3a3",
      "font": { "size": 9, "weight": 600 },
      "value": "SELECTED"
    },
    {
      "key": "playlist",
      "type": "text",
      "rect": [8, 45, 184, 27],
      "alignment": "left",
      "color": "#fafafa",
      "font": { "size": 19, "weight": 700 },
      "text-overflow": "fade"
    },
    {
      "key": "hint",
      "type": "text",
      "rect": [8, 81, 184, 12],
      "alignment": "center",
      "color": "#737373",
      "font": { "size": 8, "weight": 700 }
    }
  ]
}
