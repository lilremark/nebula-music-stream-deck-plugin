{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/layout.json",
  "id": "com.lilremark.nebula-music.playlist-browser",
  "items": [
    { "key": "icon", "type": "pixmap", "rect": [8, 20, 42, 44] },
    {
      "key": "label",
      "type": "text",
      "rect": [59, 10, 135, 18],
      "alignment": "left",
      "color": "#a3a3a3",
      "font": { "size": 10, "weight": 700 },
      "value": "PLAYLIST"
    },
    {
      "key": "playlist",
      "type": "text",
      "rect": [59, 32, 135, 29],
      "alignment": "left",
      "color": "#fafafa",
      "font": { "size": 17, "weight": 700 },
      "text-overflow": "ellipsis"
    },
    {
      "key": "position",
      "type": "text",
      "rect": [59, 67, 135, 16],
      "alignment": "left",
      "color": "#737373",
      "font": { "size": 10, "weight": 500 }
    }
  ]
}
