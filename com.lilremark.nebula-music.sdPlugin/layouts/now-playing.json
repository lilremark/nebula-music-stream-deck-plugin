{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/layout.json",
  "id": "com.lilremark.nebula-music.now-playing",
  "items": [
    {
      "key": "artwork",
      "type": "pixmap",
      "rect": [4, 4, 64, 92]
    },
    {
      "key": "label",
      "type": "text",
      "rect": [76, 5, 116, 13],
      "alignment": "left",
      "color": "#a3a3a3",
      "font": { "size": 8, "weight": 700 },
      "value": "NOW PLAYING"
    },
    {
      "key": "trackTitle",
      "type": "text",
      "rect": [76, 21, 116, 20],
      "alignment": "left",
      "color": "#fafafa",
      "font": { "size": 14, "weight": 700 },
      "text-overflow": "ellipsis"
    },
    {
      "key": "artist",
      "type": "text",
      "rect": [76, 43, 116, 14],
      "alignment": "left",
      "color": "#a3a3a3",
      "font": { "size": 10, "weight": 500 },
      "text-overflow": "ellipsis"
    },
    {
      "key": "album",
      "type": "text",
      "rect": [76, 57, 116, 13],
      "alignment": "left",
      "color": "#737373",
      "font": { "size": 9, "weight": 500 },
      "text-overflow": "ellipsis"
    },
    {
      "key": "time",
      "type": "text",
      "rect": [76, 72, 116, 12],
      "alignment": "left",
      "color": "#a3a3a3",
      "font": { "size": 9, "weight": 500 }
    },
    {
      "key": "progress",
      "type": "bar",
      "rect": [76, 88, 116, 4],
      "range": { "min": 0, "max": 100 },
      "bar_bg_c": "#262626",
      "bar_fill_c": "#3b82c4",
      "border_w": 0,
      "subtype": 0,
      "value": 0
    }
  ]
}
