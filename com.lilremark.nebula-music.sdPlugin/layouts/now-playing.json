{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/layout.json",
  "id": "com.lilremark.nebula-music.now-playing",
  "items": [
    {
      "key": "label",
      "type": "text",
      "rect": [8, 7, 96, 14],
      "alignment": "left",
      "color": "#737373",
      "font": { "size": 9, "weight": 700 },
      "value": "NOW PLAYING"
    },
    {
      "key": "state",
      "type": "text",
      "rect": [108, 7, 84, 14],
      "alignment": "right",
      "color": "#3b82c4",
      "font": { "size": 9, "weight": 700 }
    },
    {
      "key": "trackTitle",
      "type": "text",
      "rect": [8, 29, 184, 20],
      "alignment": "left",
      "color": "#fafafa",
      "font": { "size": 15, "weight": 700 },
      "text-overflow": "fade"
    },
    {
      "key": "artist",
      "type": "text",
      "rect": [8, 51, 184, 13],
      "alignment": "left",
      "color": "#d4d4d4",
      "font": { "size": 10, "weight": 600 },
      "text-overflow": "fade"
    },
    {
      "key": "album",
      "type": "text",
      "rect": [8, 66, 184, 12],
      "alignment": "left",
      "color": "#737373",
      "font": { "size": 9, "weight": 500 },
      "text-overflow": "fade"
    },
    {
      "key": "time",
      "type": "text",
      "rect": [8, 83, 68, 11],
      "alignment": "left",
      "color": "#a3a3a3",
      "font": { "size": 8, "weight": 600 }
    },
    {
      "key": "progress",
      "type": "bar",
      "rect": [80, 87, 112, 4],
      "range": { "min": 0, "max": 100 },
      "bar_bg_c": "#262626",
      "bar_fill_c": "#3b82c4",
      "border_w": 0,
      "subtype": 0,
      "value": 0
    }
  ]
}
