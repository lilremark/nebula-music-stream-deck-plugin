{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/layout.json",
  "id": "com.lilremark.nebula-music.now-playing",
  "items": [
    {
      "key": "artwork",
      "type": "pixmap",
      "rect": [0, 0, 100, 100]
    },
    {
      "key": "trackTitle",
      "type": "text",
      "rect": [108, 7, 88, 20],
      "alignment": "left",
      "color": "#fafafa",
      "font": { "size": 14, "weight": 700 },
      "text-overflow": "fade"
    },
    {
      "key": "artist",
      "type": "text",
      "rect": [108, 31, 88, 14],
      "alignment": "left",
      "color": "#d4d4d4",
      "font": { "size": 10, "weight": 500 },
      "text-overflow": "fade"
    },
    {
      "key": "album",
      "type": "text",
      "rect": [108, 48, 88, 13],
      "alignment": "left",
      "color": "#a3a3a3",
      "font": { "size": 9, "weight": 500 },
      "text-overflow": "fade"
    },
    {
      "key": "time",
      "type": "text",
      "rect": [108, 67, 88, 12],
      "alignment": "left",
      "color": "#a3a3a3",
      "font": { "size": 9, "weight": 500 }
    },
    {
      "key": "progress",
      "type": "bar",
      "rect": [108, 87, 84, 4],
      "range": { "min": 0, "max": 100 },
      "bar_bg_c": "#262626",
      "bar_fill_c": "#3b82c4",
      "border_w": 0,
      "subtype": 0,
      "value": 0
    }
  ]
}
