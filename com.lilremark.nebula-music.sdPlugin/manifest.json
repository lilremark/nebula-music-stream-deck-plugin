{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Actions": [
    {
      "Controllers": ["Keypad", "Encoder"],
      "Encoder": {
        "Icon": "imgs/key-now-playing",
        "background": "imgs/touch-background",
        "layout": "layouts/now-playing.json",
        "StackColor": "#06b6d4",
        "TriggerDescription": {
          "Push": "Play or pause",
          "Rotate": "Seek",
          "Touch": "Scrub to position"
        }
      },
      "Icon": "imgs/action-now-playing",
      "Name": "Now Playing",
      "States": [
        {
          "Image": "imgs/key-now-playing",
          "FontSize": 9,
          "FontStyle": "Bold",
          "ShowTitle": true,
          "TitleAlignment": "bottom",
          "TitleColor": "#FFFFFF"
        }
      ],
      "UUID": "com.lilremark.nebula-music.now-playing",
      "UserTitleEnabled": false
    },
    {
      "Controllers": ["Keypad"],
      "DisableAutomaticStates": true,
      "Icon": "imgs/action-play-pause",
      "Name": "Play / Pause",
      "States": [
        {
          "Image": "imgs/play",
          "Name": "Paused",
          "ShowTitle": false
        },
        {
          "Image": "imgs/pause",
          "Name": "Playing",
          "ShowTitle": false
        }
      ],
      "UUID": "com.lilremark.nebula-music.play-pause",
      "UserTitleEnabled": false
    },
    {
      "Controllers": ["Keypad"],
      "Icon": "imgs/action-previous",
      "Name": "Previous",
      "States": [
        {
          "Image": "imgs/previous",
          "ShowTitle": false
        }
      ],
      "UUID": "com.lilremark.nebula-music.previous",
      "UserTitleEnabled": false
    },
    {
      "Controllers": ["Keypad"],
      "Icon": "imgs/action-next",
      "Name": "Next",
      "States": [
        {
          "Image": "imgs/next",
          "ShowTitle": false
        }
      ],
      "UUID": "com.lilremark.nebula-music.next",
      "UserTitleEnabled": false
    },
    {
      "Controllers": ["Keypad", "Encoder"],
      "Encoder": {
        "Icon": "imgs/key-volume",
        "background": "imgs/touch-background",
        "layout": "layouts/volume.json",
        "StackColor": "#06b6d4",
        "TriggerDescription": {
          "Push": "Mute or restore volume",
          "Rotate": "Adjust volume",
          "Touch": "Set volume"
        }
      },
      "Icon": "imgs/action-volume",
      "Name": "Volume",
      "States": [
        {
          "Image": "imgs/key-volume",
          "ShowTitle": false
        }
      ],
      "UUID": "com.lilremark.nebula-music.volume",
      "UserTitleEnabled": false
    },
    {
      "Controllers": ["Keypad"],
      "Icon": "imgs/action-playlist",
      "Name": "Playlist",
      "States": [
        {
          "Image": "imgs/key-playlist",
          "ShowTitle": false
        }
      ],
      "UUID": "com.lilremark.nebula-music.playlist",
      "UserTitleEnabled": false
    },
    {
      "Controllers": ["Encoder"],
      "Encoder": {
        "Icon": "imgs/key-playlist-browser",
        "background": "imgs/touch-background",
        "layout": "layouts/playlist.json",
        "StackColor": "#06b6d4",
        "TriggerDescription": {
          "Push": "Play selected playlist",
          "Rotate": "Choose playlist",
          "Touch": "Play selected playlist"
        }
      },
      "Icon": "imgs/action-playlist-browser",
      "Name": "Playlist Browser",
      "States": [
        {
          "Image": "imgs/key-playlist-browser",
          "ShowTitle": false
        }
      ],
      "UUID": "com.lilremark.nebula-music.playlist-browser",
      "UserTitleEnabled": false
    },
    {
      "Controllers": ["Keypad"],
      "Icon": "imgs/action-connection",
      "Name": "Connection",
      "States": [
        {
          "Image": "imgs/key-connection",
          "ShowTitle": false
        }
      ],
      "UUID": "com.lilremark.nebula-music.connection",
      "UserTitleEnabled": false
    }
  ],
  "Author": "lilremark",
  "Category": "Nebula Music",
  "CategoryIcon": "imgs/category",
  "CodePath": "bin/plugin.js",
  "Description": "Control the active Nebula Music browser session from Stream Deck and Stream Deck+.",
  "Icon": "imgs/plugin",
  "Name": "Nebula Music",
  "Nodejs": {
    "Version": "24"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    },
    {
      "Platform": "mac",
      "MinimumVersion": "13"
    }
  ],
  "PropertyInspectorPath": "ui/property-inspector.html",
  "SDKVersion": 3,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "UUID": "com.lilremark.nebula-music",
  "Version": "0.1.0.0"
}
