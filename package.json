{
  "name": "nebula-music-stream-deck-plugin",
  "version": "1.1.5",
  "private": true,
  "description": "Stream Deck controls for a Nebula Music browser session.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "node scripts/clean.mjs",
    "dev": "node scripts/build.mjs --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "install:local": "npm run build && streamdeck link com.lilremark.nebula-music.sdPlugin && streamdeck restart com.lilremark.nebula-music",
    "lint": "eslint .",
    "package:local": "npm run build && streamdeck pack com.lilremark.nebula-music.sdPlugin --force --output dist --no-update-check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "validate": "streamdeck validate com.lilremark.nebula-music.sdPlugin --no-update-check",
    "pack:dry": "streamdeck pack com.lilremark.nebula-music.sdPlugin --dry-run --no-update-check",
    "pack": "streamdeck pack com.lilremark.nebula-music.sdPlugin --no-update-check",
    "preview:ui": "node scripts/render-ui-preview.mjs",
    "smoke:plugin": "node scripts/smoke-plugin.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run smoke:plugin"
  },
  "dependencies": {
    "@elgato/streamdeck": "2.1.1",
    "ws": "8.21.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@elgato/cli": "1.8.1",
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "4.1.10",
    "esbuild": "0.28.2",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "sharp": "0.35.3",
    "typescript": "7.0.2",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  },
  "overrides": {
    "filelist": "2.0.2"
  }
}
